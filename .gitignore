# Projects: each one is its own git repo (see projects/README.md)
projects/*
!projects/README.md

# Machine-specific config and secrets
.mcp.json
.env
.env.*
!.env.example

# Originals fetched from other repos; we link to them, never commit them
vendor/

# Rendered media: video sources are committed, renders are not
*.mp4
*.mov
*.webm

# Local scratch
.archive/
references/
# A skill's references/ folder is part of the skill
!skills/*/references/

# Python
__pycache__/
*.pyc
.venv/
